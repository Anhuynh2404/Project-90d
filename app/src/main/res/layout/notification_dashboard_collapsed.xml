<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_collapsed_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_notif_card"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <!-- Header Row: Full Width -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_collapsed_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌿 PROJECT 90 • NGÀY 12/90"
            android:textColor="#68D391"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notif_collapsed_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 7N"
            android:textColor="#FFB800"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_notif_streak"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp" />
    </LinearLayout>

    <!-- Subtitle and Progress Row: Full Width -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical">

        <ProgressBar
            android:id="@+id/notif_collapsed_progressbar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="65"
            android:progressDrawable="@drawable/notif_progressbar" />

        <TextView
            android:id="@+id/notif_collapsed_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="8/12 (67%)"
            android:textColor="#9AE6B4"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Status message: Full Width -->
    <TextView
        android:id="@+id/notif_collapsed_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="💧 1.250/2000ml • 👟 6.840/10k bước (Vuốt xuống để nạp nhanh)"
        android:textColor="#E2F2E8"
        android:textSize="10.5sp"
        android:singleLine="true"
        android:ellipsize="end" />

</LinearLayout>
