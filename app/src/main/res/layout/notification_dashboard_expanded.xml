<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_notif_card"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <!-- Top Command Header: Full Width -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_expanded_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌿 PROJECT 90 • NGÀY 12 / 90"
                android:textColor="#68D391"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/notif_expanded_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Còn 78 ngày • Pedometer 24/7 &amp; Pomodoro"
                android:textColor="#B8D4C2"
                android:textSize="10sp"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/notif_expanded_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 7 Ngày Chuỗi"
            android:textColor="#FFB800"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_notif_streak"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp" />
    </LinearLayout>

    <!-- Main Progress Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TIẾN ĐỘ KỶ LUẬT HÔM NAY"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_expanded_progress_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8 / 12 Mục (67%)"
                android:textColor="#68D391"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/notif_expanded_progressbar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progress="67"
            android:progressDrawable="@drawable/notif_progressbar" />
    </LinearLayout>

    <!-- Mini Dashboard 4-Tile Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">

        <!-- Stat 1: Steps (Pedometer 24/7) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_stat"
            android:paddingVertical="6dp"
            android:paddingHorizontal="4dp"
            android:layout_marginEnd="3dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👟 BƯỚC CHÂN"
                android:textColor="#9AE6B4"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/notif_stat_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="6.840/10k"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:gravity="center" />
        </LinearLayout>

        <!-- Stat 2: Water -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_stat"
            android:paddingVertical="6dp"
            android:paddingHorizontal="4dp"
            android:layout_marginEnd="3dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💧 NƯỚC UỐNG"
                android:textColor="#9AE6B4"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/notif_stat_water"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="1.500/2L"
                android:textColor="#4FD1C5"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:gravity="center" />
        </LinearLayout>

        <!-- Stat 3: Pomodoro / Thể lực -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_stat"
            android:paddingVertical="6dp"
            android:paddingHorizontal="4dp"
            android:layout_marginEnd="3dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱️ POMODORO"
                android:textColor="#9AE6B4"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/notif_stat_workout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="25:00 Sẵn sàng"
                android:textColor="#68D391"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:gravity="center" />
        </LinearLayout>

        <!-- Stat 4: No Sugar -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_stat"
            android:paddingVertical="6dp"
            android:paddingHorizontal="4dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚫 NO SUGAR"
                android:textColor="#9AE6B4"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/notif_stat_sugar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="ĐÃ ĐẠT ✅"
                android:textColor="#48BB78"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <!-- Checklist Status Summary Box -->
    <LinearLayout
        android:id="@+id/notif_expanded_summary_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_notif_summary"
        android:padding="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_expanded_summary_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ CÁC MỤC CHƯA HOÀN THÀNH HÔM NAY:"
            android:textColor="#FFA726"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_expanded_summary_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="• Đọc sách 20 phút\n• Viết 3 dòng nhật ký tối\n• Uống thêm 500ml nước"
            android:textColor="#F0FFF4"
            android:textSize="10.5sp"
            android:lineSpacingExtra="1.5dp" />
    </LinearLayout>

    <!-- Interactive Quick Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_btn_open_app"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_button_primary"
            android:gravity="center"
            android:text="📋 DASHBOARD"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:paddingHorizontal="4dp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/notif_btn_add_water"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1.15"
            android:background="@drawable/bg_notif_button_subtle"
            android:gravity="center"
            android:text="💧 Nạp 250ml nước"
            android:textColor="#4FD1C5"
            android:textSize="10sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:paddingHorizontal="4dp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/notif_btn_add_steps"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_button_subtle"
            android:gravity="center"
            android:text="👟 +500 bước"
            android:textColor="#FFB800"
            android:textSize="10sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:paddingHorizontal="4dp" />
    </LinearLayout>

</LinearLayout>
